{
  "name": "sprechprobe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-scenes.ts",
    "audio": "node scripts/generate-audio.ts",
    "audio:prune": "node scripts/generate-audio.ts --prune",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
